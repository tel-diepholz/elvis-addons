# Netzwerkstart UEFI. Standard ist die Festplatte – installiert wird nur auf ausdrückliche Auswahl.
set timeout=10
set default=0
loadfont unicode
set menu_color_normal=white/black
set menu_color_highlight=black/light-gray

menuentry "Von Festplatte starten" {
  exit 1
}
menuentry "ELVIS Arbeitsplatz installieren (Abbild @VERSION@)" {
  echo "Installer wird geladen …"
  linux /installer/vmlinuz boot=live fetch=@BASE@/images/installer/filesystem.squashfs ip=dhcp elvis.config=@BASE@/config/installer.env quiet splash=off
  initrd /installer/initrd.img
}
