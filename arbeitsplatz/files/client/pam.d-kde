#%PAM-1.0
# ELVIS Arbeitsplatz: Bildschirmsperre (kscreenlocker). ELVIS-Profilkonten (UID 50000–59999) entsperren mit der
# PIN ihres ELVIS-Benutzers, andere Konten (z. B. elvisadmin) wie gewohnt mit ihrem Passwort.
auth      [success=ok default=1]     pam_succeed_if.so uid >= 50000 uid <= 59999 quiet
auth      [success=done default=die] pam_exec.so quiet expose_authtok /usr/lib/elvis/pam-unlock
@include common-auth
@include common-account
