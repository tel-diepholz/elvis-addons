[Unit]
Description=ELVIS Arbeitsplatz installieren
After=systemd-networkd-wait-online.service systemd-resolved.service
Wants=systemd-networkd-wait-online.service
Conflicts=getty@tty1.service

[Service]
Type=idle
ExecStart=/usr/local/sbin/elvis-install
StandardInput=tty-force
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
Environment=TERM=linux NEWT_COLORS=root=white,blue

[Install]
WantedBy=multi-user.target
