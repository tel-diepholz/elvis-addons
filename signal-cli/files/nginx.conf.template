# Gesicherte Schnittstelle vor signal-cli: nur mit „Authorization: Bearer <Token>“ (Token von ELVIS, {{addon.secret}})
worker_processes 1;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
  worker_connections 64;
}

http {
  access_log off;
  client_body_temp_path /tmp/nginx-body;
  proxy_temp_path /tmp/nginx-proxy;
  # Bilder gehen als Daten-URL im JSON mit (bis 16 MB, base64)
  client_max_body_size 24m;

  server {
    listen 8080;

    location / {
      # Direkter Vergleich statt map: das Token ist länger, als die Hash-Tabelle von map zulässt
      if ($http_authorization != "Bearer ${ELVIS_TOKEN}") {
        return 401;
      }
      proxy_pass http://127.0.0.1:8081;
      proxy_http_version 1.1;
      proxy_set_header Connection "";
      # Ereignisstrom (Server-Sent Events): nicht puffern, lange offen halten
      proxy_buffering off;
      proxy_cache off;
      proxy_read_timeout 1d;
      proxy_send_timeout 1d;
    }
  }
}
